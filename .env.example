# Copy this file to `.env` in the project root and set a real secret before
# deploying anywhere beyond local dev. docker-compose automatically loads
# `.env` from the project root.

# Secret used to sign JWT auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production

# Resend API key for password-reset emails (resend.com). Without it, the
# backend logs the reset link to the console instead of emailing it — fine
# for local dev. Without a verified custom domain in Resend, the account's
# free onboarding@resend.dev sender can only deliver to your own Resend
# account email, not to arbitrary users (see DEPLOYMENT_CHECKLIST.md).
RESEND_API_KEY=

# Base URL the frontend is served from — used to build the password-reset
# link emailed to users (e.g. https://chessbook-frontend.onrender.com).
FRONTEND_URL=http://localhost:5173
